# Database (local development)
DATABASE_URL=file:../db/custom.db

# Site URL (optional, defaults to Vercel production URL or owais.dev)
NEXT_PUBLIC_SITE_URL=https://owais.dev

# Telegram Bot Notifications (Receive contact form messages instantly)
# 1. Create a bot with @BotFather on Telegram to get your token
# 2. Get your chat ID from @userinfobot or https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alternative: Webhook Notifications (Discord, Slack, or generic webhook)
# DISCORD_WEBHOOK_URL=
# SLACK_WEBHOOK_URL=
# CONTACT_WEBHOOK_URL=
